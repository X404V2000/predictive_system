# Example environment file. Copy to .env and fill in only what you need.
#
# .env is git-ignored. Never commit real values: a secret committed once stays in
# history and must be rotated, because the old value remains recoverable from any
# clone even after the file is deleted.
#
# Nothing here is required by the current code. The service reads no secrets, and
# the entries below document the shape a real deployment would use.

# --- service ---------------------------------------------------------------
# HOST=0.0.0.0
# PORT=8000
# LOG_LEVEL=info

# --- limits ----------------------------------------------------------------
# Prediction horizon bounds are enforced in code (main.py); these are overrides.
# MAX_TIME_HORIZON=2.0

# --- optional integrations -------------------------------------------------
# Only needed if a future version uploads telemetry or reports errors. Both are
# read from the environment, never from a file in the repository.
# SENTRY_DSN=
# TELEMETRY_ENDPOINT=

# --- model configuration ---------------------------------------------------
# Overrides for the pose models fetched by tools/download_models.sh.
# POSE_MODEL_PATH=models/pose_landmark.onnx
# PERSON_MODEL_PATH=models/person_detect.onnx
